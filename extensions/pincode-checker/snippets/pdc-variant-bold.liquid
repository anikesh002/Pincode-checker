{% doc %}
Renders the Dark Premium variant of the Pincode Delivery Checker widget.
@param {object} block - The block object with settings
@example
{% render 'pdc-variant-bold', block: block %}
{% enddoc %}

<div class="pdc-inner">
  <div class="pdc-bold-header">
    <span class="pdc-bold-icon">📍</span>
    <div>
      <p class="pdc-bold-title">{{ block.settings.header_text | escape }}</p>
      <p class="pdc-bold-subtitle">Enter 6-digit pincode to check</p>
    </div>
  </div>
  <div class="pdc-bold-circle pdc-bold-circle--top"></div>
  <div class="pdc-bold-circle pdc-bold-circle--bottom"></div>
  <div class="pdc-digit-boxes" aria-hidden="true">
    <span class="pdc-digit-box">–</span>
    <span class="pdc-digit-box">–</span>
    <span class="pdc-digit-box">–</span>
    <span class="pdc-digit-box">–</span>
    <span class="pdc-digit-box">–</span>
    <span class="pdc-digit-box">–</span>
  </div>
  <div class="pdc-input-row">
    <input type="text" class="pdc-input" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" placeholder="Type pincode here..." aria-label="Enter pincode to check delivery" />
    <button class="pdc-button" type="button" disabled aria-label="Check delivery">
      <span class="pdc-button-text">GO</span>
      <span class="pdc-button-loading" aria-hidden="true" style="display:none">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4"/></svg>
      </span>
    </button>
  </div>
  <div class="pdc-result" role="status" aria-live="polite" style="display:none"></div>
</div>
